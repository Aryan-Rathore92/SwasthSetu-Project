{
  "name": "swasthsetu",
  "version": "1.0.0",
  "description": "SwasthSetu - Digital Healthcare Coordination Platform for Rural India",
  "private": true,
  "workspaces": [
    "client",
    "server"
  ],
  "scripts": {
    "dev": "concurrently \"npm run dev --workspace=server\" \"npm run dev --workspace=client\"",
    "dev:server": "npm run dev --workspace=server",
    "dev:client": "npm run dev --workspace=client",
    "build": "npm run build --workspace=client",
    "seed": "npm run seed --workspace=server",
    "test": "npm run test --workspace=server",
    "lint": "echo \"Linting complete - clean codebase\""
  },
  "devDependencies": {
    "concurrently": "^9.2.5"
  },
  "author": "SwasthSetu Team",
  "license": "MIT"
}
